erDiagram
    direction LR
    User {
        Guid Id PK
        string DisplayName
        UserRole Role
    }
    PricingExceptionRequest {
        Guid Id PK
        Guid MortgageApplicationId
        Guid CreatedByUserId FK
        string RequesterName
        Guid AssignedReviewerId FK
        string AssignedReviewerName
        RequestStatus Status
        int CurrentRevisionNumber
        long Version
        DateTimeOffset CreatedAtUtc
        DateTimeOffset UpdatedAtUtc
    }
    RequestRevision {
        Guid RequestId PK,FK
        int RevisionNumber PK
        int DiscountBasisPoints
        string Reason
        Guid SubmittedByUserId FK
        DateTimeOffset SubmittedAtUtc
    }
    ReviewDecision {
        Guid Id PK
        Guid RequestId FK
        int RevisionNumber FK
        DecisionOutcome Outcome
        string ReviewReason "nullable"
        Guid ReviewedByUserId FK
        string ReviewerName
        DateTimeOffset DecidedAtUtc
    }
    HistoryEntry {
        Guid Id PK
        Guid RequestId FK
        int RevisionNumber FK
        long Sequence
        string Action
        Guid ActorUserId FK
        string Details "nullable"
        DateTimeOffset OccurredAtUtc
    }
    IdempotencyRecord {
        Guid Id PK
        Guid ActorUserId FK
        string OperationScope
        string Key
        string PayloadHash
        int ResponseStatusCode
        string ResponseJson
        string Location "nullable"
        Guid RequestId FK "nullable"
    }

    User ||--o{ PricingExceptionRequest : "CreatedByUserId"
    User ||--o{ PricingExceptionRequest : "AssignedReviewerId"
    User ||--o{ RequestRevision : "SubmittedByUserId"
    User ||--o{ ReviewDecision : "ReviewedByUserId"
    User ||--o{ HistoryEntry : "ActorUserId"
    User ||--o{ IdempotencyRecord : "ActorUserId"
    PricingExceptionRequest ||--o{ RequestRevision : "RequestId"
    PricingExceptionRequest ||--o{ HistoryEntry : "RequestId"
    PricingExceptionRequest |o--o{ IdempotencyRecord : "nullable RequestId"
    RequestRevision ||--o| ReviewDecision : "RequestId + RevisionNumber"
    RequestRevision ||--o{ HistoryEntry : "RequestId + RevisionNumber"
